meta {
  name: Submission 400
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}{{basePath}}/submission/{{submissionId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{bearerToken}}
  correlation-id: {{correlationId}}
  subscription-id: {{subscriptionId}}
}

body:json {
  {
    "declaration": {
      "role1": "1",
      "role2": "On behalf of client",
      "name": "John Smith",
      "addr1": "123 High Street",
      "addr2": "Suite 4",
      "addr3": "Leeds",
      "postcode": "LS1 1AA",
      "country": "GB",
      "selfDeclarationAgent": true,
      "isCorrectInfo": true
    },
    "transfers": []
  }
}

tests {
  test("Status code is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  
  test("Response contains error details", function () {
    const body = res.getBody();
    expect(body.error).to.exist;
    expect(body.details).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
