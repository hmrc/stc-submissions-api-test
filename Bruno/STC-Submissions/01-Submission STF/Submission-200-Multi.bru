meta {
  name: Submission 200 Multi
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}{{basePath}}/submission/{{submissionId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{bearerToken}}
  correlation-id: {{correlationId}}
  subscription-id: {{subscriptionId}}
}

body:json {
  {
    "declaration": {
      "role1": "1",
      "name": "Declarant Name",
      "addr1": "123 Main Street",
      "postcode": "AB12CD",
      "country": "GB",
      "isCorrectInfo": true
    },
    "transfers": [
      {
        "recordId": 1,
        "transactionDetails": {
          "transactionType": 1,
          "typeOfSecurity": "Ordinary Shares",
          "numberOfShares": 100,
          "originalChargingPoint": "2026-01-15",
          "considerationActual": 5000,
          "isConnectedPartiesTransactions": false,
          "companyName": "Test Corporation"
        },
        "mainSellerDetails": {
          "sellerName": "Seller Name",
          "addr1": "100 Seller Lane",
          "postcode": "AB12CD",
          "country": "GB"
        },
        "mainBuyerDetails": {
          "buyerName": "Buyer Name",
          "addr1": "50 Buyer Road",
          "postcode": "AB12CD",
          "country": "GB",
          "email": "buyer@example.com",
          "taxRate": 1
        }
      },
      {
        "recordId": 2,
        "transactionDetails": {
          "transactionType": 2,
          "typeOfSecurity": "Preference Shares",
          "numberOfShares": 200,
          "originalChargingPoint": "2026-02-20",
          "considerationActual": 10000,
          "isConnectedPartiesTransactions": true,
          "companyName": "Another Corporation"
        },
        "mainSellerDetails": {
          "sellerName": "Another Seller",
          "addr1": "200 Seller Street",
          "postcode": "CD34EF",
          "country": "GB"
        },
        "mainBuyerDetails": {
          "buyerName": "Another Buyer",
          "addr1": "75 Buyer Avenue",
          "postcode": "EF56GH",
          "country": "GB",
          "email": "another.buyer@example.com",
          "taxRate": 2
        }
      }
    ]
  }
}

tests {
  test("Status code is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response contains charge results", function () {
    const body = res.getBody();
    const success = body.success;
    const charges = success.charges;
  
    expect(success).to.be.an("object");
    expect(success.processingDate).to.exist;
  
    expect(charges).to.be.an("array");
    expect(charges).to.have.length.greaterThan(0);
  
    expect(charges[0].recordId).to.equal(1);
    expect(charges[0].utrn).to.exist;
    expect(charges[0].chargeAmount).to.exist;
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
